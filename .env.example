# ── Auth ──
# authelia: uses HTTP header set by Authelia proxy (AUTH_HEADER)
# local:    uses PHP sessions + local user DB
AUTH_MODE=local
#AUTH_HEADER=Remote-User #(only for authelia mode)
#AUTH_LOGOUT_URL=https://auth.yourdomain.com/logout  #(only for authelia mode)

# ── Database ──
# sqlite: uses /app/data/owntracks.db
# mysql:  uses the DB_* vars below
DB_TYPE=sqlite
#DB_HOST=
#DB_PORT=3306
#DB_USER=
#DB_PASS=
#DB_NAME=

# ── App ──
APP_PORT=8090
APP_DEBUG=false
TZ=America/Mexico_City
